# Copy this file to .env.local and fill in your own Supabase project's values
# (Project Settings → API in the Supabase dashboard). .env.local is gitignored.

# Used by the app in the browser — safe to expose (see supabase/schema.sql's
# RLS policies for what the anon key can and can't do).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Used only by `npm run seed`, run locally, never shipped to the browser.
# The SERVICE ROLE key bypasses RLS entirely — never put it behind a VITE_
# prefix (Vite would bundle it into the public build) and never commit it.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
